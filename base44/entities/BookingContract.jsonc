{
  "name": "BookingContract",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional note describing this contract record"
    },
    "booking_id": {
      "type": "string",
      "description": "Related booking ID"
    },
    "client_id": {
      "type": "string",
      "description": "Client user ID"
    },
    "client_email": {
      "type": "string",
      "description": "Client email",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "creator_id": {
      "type": "string",
      "description": "Creator/lensman ID"
    },
    "creator_email": {
      "type": "string",
      "description": "Creator email",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "creator_name": {
      "type": "string",
      "description": "Creator name"
    },
    "format_name": {
      "type": "string",
      "description": "Booked format/package name"
    },
    "shoot_date": {
      "type": "string",
      "format": "date",
      "description": "Shoot date"
    },
    "shoot_time": {
      "type": "string",
      "description": "Shoot start time"
    },
    "shoot_location": {
      "type": "string",
      "description": "Shoot location"
    },
    "creator_fee": {
      "type": "number",
      "description": "Creator fee"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Booking add-ons"
    },
    "total_paid": {
      "type": "number",
      "description": "Total paid by client"
    },
    "included_edited_photos": {
      "type": "number",
      "default": 30,
      "description": "Included edited photos"
    },
    "unedited_delivery_deadline": {
      "type": "string",
      "format": "date",
      "description": "Deadline for unedited delivery"
    },
    "edited_delivery_deadline": {
      "type": "string",
      "format": "date",
      "description": "Deadline for edited delivery"
    },
    "contract_text": {
      "type": "string",
      "description": "Rendered agreement text"
    },
    "terms_version": {
      "type": "string",
      "description": "Terms version active for this booking"
    },
    "privacy_version": {
      "type": "string",
      "description": "Privacy version active for this booking"
    },
    "version": {
      "type": "string",
      "description": "Contract template version"
    },
    "client_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Client acceptance timestamp"
    },
    "creator_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creator acceptance timestamp"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Contract creation timestamp"
    },
    "quote_id": {
      "type": "string",
      "description": "The accepted quote this contract was written for. A new accepted quote gets a new contract."
    },
    "status": {
      "type": "string",
      "description": "active, or superseded once a newer quote replaced the one this contract was written for. Older contracts with no value are active."
    },
    "superseded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a newer quote replaced this contract"
    },
    "base_price": {
      "type": "number",
      "description": "The quoted price of the shoot itself, before add-ons, in dollars"
    },
    "add_on_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "description": "Each add-on the client picked, with its price"
    },
    "service_fee": {
      "type": "number",
      "description": "Stelli's 14% service fee charged to the client on top of the creator's price, in dollars"
    },
    "creator_net": {
      "type": "number",
      "description": "What the creator receives after Stelli's 14% platform fee, in dollars"
    },
    "creator_user_id": {
      "type": "string",
      "description": "The creator's account ID. Decides who may read the agreement (creator_id holds the creator profile's ID)."
    },
    "legal_names_added_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator's legal name was written into the agreement. That happens once the booking is paid, so it is never visible before."
    }
  },
  "required": [
    "booking_id",
    "client_email",
    "creator_id",
    "format_name",
    "shoot_date",
    "contract_text",
    "version",
    "created_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.creator_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}