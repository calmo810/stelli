{
  "name": "CreatorContact",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional note describing this contact record"
    },
    "lensman_id": {
      "type": "string",
      "description": "The creator profile this private record belongs to"
    },
    "user_id": {
      "type": "string",
      "description": "Account that owns the creator profile"
    },
    "full_name": {
      "type": "string",
      "description": "The creator's real name. Never shown to clients."
    },
    "email": {
      "type": "string",
      "description": "Contact email for booking updates. Not the login email."
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram handle, kept for Stelli's records only"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes from vetting",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "review_note": {
      "type": "string",
      "description": "Why the creator is under review",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status_notified": {
      "type": "string",
      "description": "The status this creator was last emailed about, so each decision sends one email only",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "lensman_id",
    "user_id",
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}