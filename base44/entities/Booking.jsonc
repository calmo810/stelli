{
  "name": "Booking",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional note describing this booking record"
    },
    "lensman_id": {
      "type": "string",
      "description": "ID of the booked lensman"
    },
    "lensman_name": {
      "type": "string",
      "description": "Display name of the lensman"
    },
    "lensman_email": {
      "type": "string",
      "description": "Email of the account that owns the booked creator profile",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "client_id": {
      "type": "string",
      "description": "Client user ID when available"
    },
    "creator_id": {
      "type": "string",
      "description": "User ID of the account that owns the booked creator profile"
    },
    "creator_email": {
      "type": "string",
      "description": "Email of the account that owns the booked creator profile",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "contract_id": {
      "type": "string",
      "description": "Generated booking contract ID"
    },
    "terms_version": {
      "type": "string",
      "description": "Terms version active when booking was made"
    },
    "privacy_version": {
      "type": "string",
      "description": "Privacy version active when booking was made"
    },
    "client_contract_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether client accepted the booking contract"
    },
    "creator_contract_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether creator accepted the booking contract"
    },
    "client_contract_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Client booking contract acceptance time"
    },
    "creator_contract_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creator booking contract acceptance time"
    },
    "client_name": {
      "type": "string",
      "description": "Client full name"
    },
    "client_email": {
      "type": "string",
      "description": "Client email",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "client_phone": {
      "type": "string",
      "description": "Client phone",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Requested shoot date"
    },
    "event_time": {
      "type": "string",
      "description": "Requested start time"
    },
    "event_type": {
      "type": "string",
      "description": "Legacy event type from earlier bookings"
    },
    "event_description": {
      "type": "string",
      "description": "Anything the client wants the creator to know"
    },
    "location": {
      "type": "string",
      "description": "Shoot location/address"
    },
    "shoot_setting": {
      "type": "string",
      "enum": [
        "outdoor",
        "indoor",
        "flexible"
      ],
      "default": "flexible",
      "description": "Whether the shoot takes place outdoors, indoors, or is still being decided"
    },
    "weather_alerts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether both people opted into outdoor weather updates by email"
    },
    "weather_alerts_sent_for": {
      "type": "string",
      "description": "A fingerprint of the latest weather alert sent, used to prevent duplicate sends"
    },
    "weather_alert_48h_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the optional 48-hour weather outlook was sent"
    },
    "weather_alert_3h_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the optional 3-hour weather update was sent"
    },
    "attendees": {
      "type": "number",
      "description": "Number of attendees"
    },
    "budget": {
      "type": "string",
      "description": "What the client said they expect to spend, in their own words"
    },
    "duration": {
      "type": "string",
      "description": "How long the client expects the shoot to run"
    },
    "total_price": {
      "type": "number",
      "description": "Quote plus the add-ons the client ticked"
    },
    "quote_id": {
      "type": "string",
      "description": "The quote the client accepted and is paying"
    },
    "fee_amount": {
      "type": "number",
      "description": "Stelli service fee charged to the client on top of the quote"
    },
    "creator_payout": {
      "type": "number",
      "description": "Amount transferred to the creator when the hold is released"
    },
    "amount_charged": {
      "type": "number",
      "description": "What Stripe actually charged the client, in dollars, including any tax"
    },
    "tax_amount": {
      "type": "number",
      "description": "The tax part of amount_charged, in dollars"
    },
    "picked_add_ons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "description": "The add-ons the client ticked when accepting the quote"
    },
    "co_bookers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails invited to chip in toward the booking"
    },
    "album_access_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails invited to access the final album without contributing"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "quoted",
        "quote_accepted",
        "pending",
        "awaiting_creator_acceptance",
        "confirmed",
        "in_progress",
        "awaiting_delivery",
        "delivered",
        "completed",
        "cancelled",
        "disputed"
      ],
      "default": "requested",
      "description": "Booking status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "held",
        "released",
        "refunded",
        "partially_refunded"
      ],
      "default": "pending",
      "description": "Payment/escrow status. Processing means the client paid by bank and the money has not cleared yet."
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client's card was charged"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the booking closed out"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe payment intent for the client charge"
    },
    "stripe_charge_id": {
      "type": "string",
      "description": "Stripe charge held on Stelli's balance"
    },
    "stripe_checkout_session_id": {
      "type": "string",
      "description": "The latest Stripe Checkout Session created for this booking"
    },
    "transfer_group": {
      "type": "string",
      "description": "Shared by the charge and the later payout so the money is traceable"
    },
    "stripe_transfer_id": {
      "type": "string",
      "description": "Stripe transfer that paid the creator out"
    },
    "stripe_transfer_reversal_id": {
      "type": "string",
      "description": "Set if a creator payout was pulled back after a refund"
    },
    "dispute_status": {
      "type": "string",
      "description": "Empty unless the client opened a card dispute; otherwise Stripe's dispute status"
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the held funds were released to the creator"
    },
    "released_by": {
      "type": "string",
      "enum": [
        "auto",
        "founder"
      ],
      "description": "Whether the payout was automatic or decided by a founder"
    },
    "refund_amount": {
      "type": "number",
      "description": "Amount refunded to the client out of the held funds"
    },
    "refunded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client refund was issued"
    },
    "needs_payout_setup": {
      "type": "boolean",
      "default": false,
      "description": "Funds are held because the creator has no connected account yet"
    },
    "delivery_deadline": {
      "type": "string",
      "format": "date",
      "description": "Expected delivery date"
    },
    "unedited_link": {
      "type": "string",
      "description": "Link to the unedited set, posted before the final edits"
    },
    "unedited_delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator posted the unedited set"
    },
    "delivery_link": {
      "type": "string",
      "description": "URL to the final edited gallery, pasted by the creator"
    },
    "album_token": {
      "type": "string",
      "description": "Random code that unlocks the shareable memory album. The booking ID alone is not enough to open it."
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator marked the final edits delivered"
    },
    "release_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 48 hour window closes and the payout releases"
    },
    "delivery_notes": {
      "type": "string",
      "description": "Notes from lensman on delivery"
    },
    "client_confirmed_delivery": {
      "type": "boolean",
      "description": "Whether client confirmed receipt"
    },
    "problem_reported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client reported a problem with the delivery"
    },
    "problem_note": {
      "type": "string",
      "description": "What the client said was wrong"
    },
    "flagged_for_review": {
      "type": "boolean",
      "default": false,
      "description": "Funds are frozen and a founder must decide release or refund"
    },
    "flag_reason": {
      "type": "string",
      "description": "Why the booking is sitting in the founder queue"
    },
    "client_last_read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client last opened this thread"
    },
    "creator_last_read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator last opened this thread"
    },
    "client_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last email sent to the client about this thread"
    },
    "creator_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last email sent to the creator about this thread"
    },
    "first_reply_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator first replied to this request"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the booking was cancelled"
    },
    "cancelled_by": {
      "type": "string",
      "enum": [
        "client",
        "creator"
      ],
      "description": "Which side cancelled"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Reason given for the cancellation"
    },
    "billing_address": {
      "type": "string",
      "description": "Client billing address",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_livemode": {
      "type": "boolean",
      "description": "Whether the client's payment was taken in Stripe live mode. False means a test payment that must never be paid out with real money."
    },
    "stray_payment_count": {
      "type": "number",
      "default": 0,
      "description": "How many unmatched payments on this booking are still open (each one is a StrayPayment record)"
    },
    "stray_payment_intent_id": {
      "type": "string",
      "description": "Summary: the latest open payment that arrived for this booking but did not match its accepted quote (old checkout, wrong amount, cancelled or already-paid booking). Each such payment is its own StrayPayment record; this is empty once none is open."
    },
    "stray_payment_amount": {
      "type": "number",
      "description": "Summary: what the open unmatched payments charged in all, in dollars"
    },
    "stray_payment_reason": {
      "type": "string",
      "description": "Why the stray payment was not treated as this booking's payment"
    },
    "stray_payment_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the stray payment arrived"
    },
    "payout_lock": {
      "type": "string",
      "description": "Set while a payout, refund, cancellation or problem report is working on this booking's money, so only one of them runs at a time. Empty when nothing is in progress."
    },
    "payout_lock_at": {
      "type": "string",
      "format": "date-time",
      "description": "When payout_lock was taken. A lock older than ten minutes was left by a run that died and may be taken over."
    },
    "payout_error": {
      "type": "string",
      "description": "What Stripe said the last time the payout to the creator failed. Empty once it goes through."
    },
    "payout_attempts": {
      "type": "number",
      "description": "How many times the payout to the creator has failed"
    },
    "payout_failed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the payout to the creator last failed"
    },
    "cancellation_payout_due": {
      "type": "boolean",
      "description": "A late client cancellation left the creator a share that has not been paid yet"
    },
    "payout_key_version": {
      "type": "number",
      "description": "Bumped each time Stripe definitively refuses the payout transfer, so the next attempt is not answered with the same stored refusal"
    },
    "reversal_status": {
      "type": "string",
      "description": "Where pulling the creator's payout back stands after a refund or a lost dispute: empty (nothing to pull back), needed, done or failed. Tracked separately from the refund itself so a failed pull-back can be retried."
    },
    "reversal_amount_due": {
      "type": "number",
      "description": "How much of the creator's payout should come back, in dollars"
    },
    "reversal_amount_done": {
      "type": "number",
      "description": "How much of the creator's payout has actually been pulled back, in dollars"
    },
    "reversal_error": {
      "type": "string",
      "description": "What Stripe said the last time pulling the payout back failed"
    },
    "reversal_attempts": {
      "type": "number",
      "description": "How many times pulling the payout back has failed"
    },
    "creator_payout_original": {
      "type": "number",
      "description": "The creator's payout before a partial refund or late cancellation reduced it, in dollars"
    },
    "album_token_reset_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the album link was last reset, cutting off the previous link"
    },
    "album_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator last emailed the client their album link (one email per 10 minutes)"
    },
    "manual_payout_id": {
      "type": "string",
      "description": "Set when a founder paid this booking's creator by hand. The automatic payout treats the booking as already paid."
    }
  },
  "required": [
    "lensman_id",
    "client_name",
    "client_email",
    "event_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}