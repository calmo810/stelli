{
  "name": "Booking",
  "type": "object",
  "properties": {
    "lensman_id": {
      "type": "string",
      "description": "ID of the booked lensman"
    },
    "lensman_name": {
      "type": "string",
      "description": "Display name of the lensman"
    },
    "lensman_email": {
      "type": "string",
      "description": "Email of the account that owns the booked creator profile"
    },
    "client_id": {
      "type": "string",
      "description": "Client user ID when available"
    },
    "creator_id": {
      "type": "string",
      "description": "User ID of the account that owns the booked creator profile"
    },
    "creator_email": {
      "type": "string",
      "description": "Email of the account that owns the booked creator profile"
    },
    "contract_id": {
      "type": "string",
      "description": "Generated booking contract ID"
    },
    "terms_version": {
      "type": "string",
      "description": "Terms version active when booking was made"
    },
    "privacy_version": {
      "type": "string",
      "description": "Privacy version active when booking was made"
    },
    "client_contract_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether client accepted the booking contract"
    },
    "creator_contract_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether creator accepted the booking contract"
    },
    "client_contract_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Client booking contract acceptance time"
    },
    "creator_contract_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creator booking contract acceptance time"
    },
    "client_name": {
      "type": "string",
      "description": "Client full name"
    },
    "client_email": {
      "type": "string",
      "description": "Client email"
    },
    "client_phone": {
      "type": "string",
      "description": "Client phone"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Requested shoot date"
    },
    "event_time": {
      "type": "string",
      "description": "Requested start time"
    },
    "event_type": {
      "type": "string",
      "description": "Legacy event type from earlier bookings"
    },
    "event_description": {
      "type": "string",
      "description": "Anything the client wants the creator to know"
    },
    "location": {
      "type": "string",
      "description": "Shoot location/address"
    },
    "attendees": {
      "type": "number",
      "description": "Number of attendees"
    },
    "total_price": {
      "type": "number",
      "description": "Quote plus the add-ons the client ticked"
    },
    "fee_amount": {
      "type": "number",
      "description": "Stelli service fee charged to the client on top of the quote"
    },
    "creator_payout": {
      "type": "number",
      "description": "Amount transferred to the creator when the hold is released"
    },
    "picked_add_ons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "description": "The add-ons the client ticked when accepting the quote"
    },
    "co_bookers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails invited to chip in toward the booking"
    },
    "album_access_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails invited to access the final album without contributing"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "quoted",
        "quote_accepted",
        "pending",
        "awaiting_creator_acceptance",
        "confirmed",
        "in_progress",
        "awaiting_delivery",
        "delivered",
        "completed",
        "cancelled",
        "disputed"
      ],
      "default": "requested",
      "description": "Booking status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "held",
        "released",
        "refunded"
      ],
      "default": "pending",
      "description": "Payment/escrow status"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client's card was charged"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the booking closed out"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe payment intent for the client charge"
    },
    "stripe_charge_id": {
      "type": "string",
      "description": "Stripe charge held on Stelli's balance"
    },
    "transfer_group": {
      "type": "string",
      "description": "Shared by the charge and the later payout so the money is traceable"
    },
    "stripe_transfer_id": {
      "type": "string",
      "description": "Stripe transfer that paid the creator out"
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the held funds were released to the creator"
    },
    "released_by": {
      "type": "string",
      "enum": [
        "auto",
        "founder"
      ],
      "description": "Whether the payout was automatic or decided by a founder"
    },
    "refund_amount": {
      "type": "number",
      "description": "Amount refunded to the client out of the held funds"
    },
    "refunded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client refund was issued"
    },
    "needs_payout_setup": {
      "type": "boolean",
      "default": false,
      "description": "Funds are held because the creator has no connected account yet"
    },
    "delivery_deadline": {
      "type": "string",
      "format": "date",
      "description": "Expected delivery date"
    },
    "unedited_link": {
      "type": "string",
      "description": "Link to the unedited set, posted before the final edits"
    },
    "unedited_delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator posted the unedited set"
    },
    "delivery_link": {
      "type": "string",
      "description": "URL to the final edited gallery, pasted by the creator"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator marked the final edits delivered"
    },
    "release_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 48 hour window closes and the payout releases"
    },
    "delivery_notes": {
      "type": "string",
      "description": "Notes from lensman on delivery"
    },
    "client_confirmed_delivery": {
      "type": "boolean",
      "description": "Whether client confirmed receipt"
    },
    "problem_reported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client reported a problem with the delivery"
    },
    "problem_note": {
      "type": "string",
      "description": "What the client said was wrong"
    },
    "flagged_for_review": {
      "type": "boolean",
      "default": false,
      "description": "Funds are frozen and a founder must decide release or refund"
    },
    "flag_reason": {
      "type": "string",
      "description": "Why the booking is sitting in the founder queue"
    },
    "client_last_read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the client last opened this thread"
    },
    "creator_last_read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator last opened this thread"
    },
    "client_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last email sent to the client about this thread"
    },
    "creator_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last email sent to the creator about this thread"
    },
    "first_reply_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator first replied to this request"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the booking was cancelled"
    },
    "cancelled_by": {
      "type": "string",
      "enum": [
        "client",
        "creator"
      ],
      "description": "Which side cancelled"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Reason given for the cancellation"
    },
    "billing_address": {
      "type": "string",
      "description": "Client billing address"
    }
  },
  "required": [
    "lensman_id",
    "client_name",
    "client_email",
    "event_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.lensman_email": "{{user.email}}"
        },
        {
          "data.creator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}