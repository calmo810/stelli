{
  "name": "Lensman",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Account that owns this creator profile, set when the creator applies"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of the lensman"
    },
    "display_name": {
      "type": "string",
      "description": "Public display name"
    },
    "slug": {
      "type": "string",
      "description": "Public profile slug for getstelli.com/creators/slug"
    },
    "email": {
      "type": "string",
      "description": "Contact email shown on the profile (display only, never used for access)"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "market": {
      "type": "string",
      "enum": [
        "NYC",
        "ELON"
      ],
      "default": "NYC",
      "description": "Market this creator operates in"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram handle"
    },
    "bio": {
      "type": "string",
      "description": "Short bio about why they create"
    },
    "profile_headline": {
      "type": "string",
      "description": "Custom hero headline for public profile"
    },
    "profile_tagline": {
      "type": "string",
      "description": "Short positioning line shown on the profile"
    },
    "booking_cta": {
      "type": "string",
      "description": "Custom booking button text"
    },
    "featured_quote": {
      "type": "string",
      "description": "Short creator quote or profile note"
    },
    "one_liner": {
      "type": "string",
      "description": "Short personality line shown under the creator's name (max 80 characters)"
    },
    "prompt_question": {
      "type": "string",
      "description": "One of the six fixed profile prompts"
    },
    "prompt_answer": {
      "type": "string",
      "description": "The creator's answer to their chosen prompt (max 200 characters)"
    },
    "dont_shoot": {
      "type": "string",
      "description": "Optional line about what the creator does not shoot (max 120 characters)"
    },
    "accent_color": {
      "type": "string",
      "enum": [
        "lime",
        "cyan",
        "magenta"
      ],
      "default": "lime",
      "description": "Brand accent used for this profile's highlights only"
    },
    "cover_image": {
      "type": "string",
      "description": "Portfolio image used as the public profile header"
    },
    "cover_focal_point": {
      "type": "object",
      "description": "Focal point the cover crops around, as x/y percentages",
      "properties": {
        "x": {
          "type": "number",
          "default": 50
        },
        "y": {
          "type": "number",
          "default": 50
        }
      }
    },
    "pinned_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of up to three portfolio images shown larger on the public profile"
    },
    "profile_theme": {
      "type": "string",
      "enum": [
        "editorial_cream",
        "night_flash",
        "clean_portfolio"
      ],
      "default": "night_flash",
      "description": "Visual theme for the public profile"
    },
    "gallery_style": {
      "type": "string",
      "enum": [
        "ordered_grid",
        "hero_grid",
        "contact_sheet"
      ],
      "default": "hero_grid",
      "description": "How portfolio images are arranged"
    },
    "neighborhoods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Neighborhoods where they work"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specialties like Portraits, Events, Commercial, Music Videos"
    },
    "years_experience": {
      "type": "number",
      "description": "Years of experience"
    },
    "equipment": {
      "type": "string",
      "description": "Equipment/gear description"
    },
    "portfolio_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of portfolio images"
    },
    "portfolio_videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of portfolio videos"
    },
    "style_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Up to three style tags from the fixed market list"
    },
    "avg_rating": {
      "type": "number",
      "description": "Average star rating"
    },
    "review_count": {
      "type": "number",
      "description": "Number of reviews"
    },
    "completed_shoots": {
      "type": "number",
      "description": "Number of completed shoots"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "default": "pending",
      "description": "Vetting status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes from vetting"
    },
    "blackout_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dates when lensman is unavailable"
    },
    "profile_image": {
      "type": "string",
      "description": "Profile image URL"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect account that receives this creator's payouts"
    },
    "payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether Stripe has finished payout onboarding"
    },
    "payouts_onboarded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When payout setup completed"
    },
    "response_median_minutes": {
      "type": "number",
      "description": "Median minutes to first reply across recent requests"
    },
    "response_sample_size": {
      "type": "number",
      "description": "How many requests the median is based on"
    },
    "under_review": {
      "type": "boolean",
      "default": false,
      "description": "Flagged by a founder after a cancellation or no-show"
    },
    "review_note": {
      "type": "string",
      "description": "Why the creator is under review"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}