{
  "name": "Lensman",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Account that owns this creator profile, set when the creator applies"
    },
    "display_name": {
      "type": "string",
      "description": "Public display name. The only name clients ever see."
    },
    "slug": {
      "type": "string",
      "description": "Public profile link, generated from the display name"
    },
    "market": {
      "type": "string",
      "enum": [
        "NYC",
        "ELON"
      ],
      "default": "ELON",
      "description": "Market this creator operates in"
    },
    "bio": {
      "type": "string",
      "description": "How they shoot and what it is like to work with them"
    },
    "profile_headline": {
      "type": "string",
      "description": "Generated hero headline for the public profile"
    },
    "profile_tagline": {
      "type": "string",
      "description": "Generated from their first three specialties"
    },
    "booking_cta": {
      "type": "string",
      "description": "Generated booking button text"
    },
    "featured_quote": {
      "type": "string",
      "description": "Retired. No longer collected or shown."
    },
    "one_liner": {
      "type": "string",
      "description": "Short personality line shown under the creator's name (max 80 characters)"
    },
    "prompt_question": {
      "type": "string",
      "description": "One of the six fixed profile prompts"
    },
    "prompt_answer": {
      "type": "string",
      "description": "The creator's answer to their chosen prompt (max 200 characters)"
    },
    "dont_shoot": {
      "type": "string",
      "description": "Optional line about what the creator does not shoot (max 120 characters)"
    },
    "accent_color": {
      "type": "string",
      "enum": [
        "lime",
        "cyan",
        "magenta"
      ],
      "default": "lime",
      "description": "Brand accent used for this profile's highlights only"
    },
    "cover_image": {
      "type": "string",
      "description": "Portfolio image used as the public profile header"
    },
    "cover_focal_point": {
      "type": "object",
      "description": "Focal point the cover crops around, as x/y percentages",
      "properties": {
        "x": {
          "type": "number",
          "default": 50
        },
        "y": {
          "type": "number",
          "default": 50
        }
      }
    },
    "pinned_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of up to three portfolio images shown larger on the public profile"
    },
    "profile_theme": {
      "type": "string",
      "enum": [
        "night_flash",
        "clean_portfolio"
      ],
      "default": "night_flash",
      "description": "Visual theme for the public profile"
    },
    "gallery_style": {
      "type": "string",
      "enum": [
        "ordered_grid",
        "hero_grid",
        "contact_sheet"
      ],
      "default": "hero_grid",
      "description": "How portfolio images are arranged"
    },
    "neighborhoods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Campus spots (Elon) or neighborhoods (NYC) where they shoot"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specialties like Portraits, Events, Commercial, Music Videos"
    },
    "years_experience": {
      "type": "number",
      "description": "Years of experience"
    },
    "equipment": {
      "type": "string",
      "description": "Camera, lenses and lighting, kept short"
    },
    "portfolio_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of portfolio images, in the creator's chosen order"
    },
    "portfolio_videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of portfolio videos"
    },
    "style_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Up to three style tags from the fixed market list"
    },
    "avg_rating": {
      "type": "number",
      "description": "Average star rating"
    },
    "review_count": {
      "type": "number",
      "description": "Number of reviews"
    },
    "completed_shoots": {
      "type": "number",
      "description": "Number of completed shoots"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Vetting status. Approved profiles are public; pending and rejected are hidden."
    },
    "age_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the creator confirmed they are 18 or older"
    },
    "age_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the creator confirmed they are 18 or older"
    },
    "blackout_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dates when lensman is unavailable"
    },
    "profile_image": {
      "type": "string",
      "description": "Profile image URL"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect account that receives this creator's payouts"
    },
    "payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether Stripe has finished payout onboarding"
    },
    "payouts_onboarded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When payout setup completed"
    },
    "response_median_minutes": {
      "type": "number",
      "description": "Median minutes to first reply across recent requests"
    },
    "response_sample_size": {
      "type": "number",
      "description": "How many requests the median is based on"
    },
    "under_review": {
      "type": "boolean",
      "default": false,
      "description": "Flagged by a founder after a cancellation or no-show"
    }
  },
  "required": [
    "display_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}