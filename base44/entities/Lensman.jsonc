{
  "name": "Lensman",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Full name of the lensman"
    },
    "display_name": {
      "type": "string",
      "description": "Public display name"
    },
    "slug": {
      "type": "string",
      "description": "Public profile slug for getstelli.com/creators/slug"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "market": {
      "type": "string",
      "enum": [
        "NYC",
        "ELON"
      ],
      "default": "NYC",
      "description": "Market this creator operates in"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram handle"
    },
    "bio": {
      "type": "string",
      "description": "Short bio about why they create"
    },
    "profile_headline": {
      "type": "string",
      "description": "Custom hero headline for public profile"
    },
    "profile_tagline": {
      "type": "string",
      "description": "Short positioning line shown on the profile"
    },
    "booking_cta": {
      "type": "string",
      "description": "Custom booking button text"
    },
    "featured_quote": {
      "type": "string",
      "description": "Short creator quote or profile note"
    },
    "profile_theme": {
      "type": "string",
      "enum": [
        "editorial_cream",
        "night_flash",
        "clean_portfolio"
      ],
      "default": "night_flash",
      "description": "Visual theme for the public profile"
    },
    "gallery_style": {
      "type": "string",
      "enum": [
        "ordered_grid",
        "hero_grid",
        "contact_sheet"
      ],
      "default": "hero_grid",
      "description": "How portfolio images are arranged"
    },
    "neighborhoods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Neighborhoods where they work"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specialties like Portraits, Events, Commercial, Music Videos"
    },
    "years_experience": {
      "type": "number",
      "description": "Years of experience"
    },
    "equipment": {
      "type": "string",
      "description": "Equipment/gear description"
    },
    "portfolio_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of portfolio images"
    },
    "portfolio_videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of portfolio videos"
    },
    "rate_half_day": {
      "type": "number",
      "description": "Rate for 4-hour shoot"
    },
    "rate_full_day": {
      "type": "number",
      "description": "Rate for full-day Content Day"
    },
    "rate_custom": {
      "type": "number",
      "description": "Custom package rate"
    },
    "custom_package_description": {
      "type": "string",
      "description": "Description of custom package"
    },
    "style_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Style tags like portrait, documentary, vibrant, moody"
    },
    "avg_rating": {
      "type": "number",
      "description": "Average star rating"
    },
    "review_count": {
      "type": "number",
      "description": "Number of reviews"
    },
    "completed_shoots": {
      "type": "number",
      "description": "Number of completed shoots"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "default": "pending",
      "description": "Vetting status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes from vetting"
    },
    "blackout_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dates when lensman is unavailable"
    },
    "profile_image": {
      "type": "string",
      "description": "Profile image URL"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}