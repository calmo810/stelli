{
  "name": "LegalDocument",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "terms",
        "privacy",
        "contract_template"
      ],
      "description": "Legal document type"
    },
    "version": {
      "type": "string",
      "description": "Published document version"
    },
    "content": {
      "type": "string",
      "description": "Full document content"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date this version became effective"
    }
  },
  "required": [
    "type",
    "version",
    "content",
    "effective_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}