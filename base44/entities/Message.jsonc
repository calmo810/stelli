{
  "name": "Message",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID of the related booking"
    },
    "client_id": {
      "type": "string",
      "description": "User ID of the client on the booking"
    },
    "creator_id": {
      "type": "string",
      "description": "User ID of the creator on the booking"
    },
    "client_email": {
      "type": "string",
      "description": "Email of the booking's client, used to scope access to the conversation"
    },
    "lensman_email": {
      "type": "string",
      "description": "Email of the booking's creator, used to scope access to the conversation"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "client",
        "lensman"
      ],
      "description": "Role of sender"
    },
    "content": {
      "type": "string",
      "description": "Message text"
    },
    "kind": {
      "type": "string",
      "enum": [
        "chat",
        "system"
      ],
      "default": "chat",
      "description": "Chat bubble or a system notice rendered as a quiet card"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Attached files"
    }
  },
  "required": [
    "booking_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.lensman_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}