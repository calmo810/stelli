{
  "name": "Review",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID of the related booking"
    },
    "client_id": {
      "type": "string",
      "description": "User ID of the client who wrote the review"
    },
    "lensman_id": {
      "type": "string",
      "description": "ID of the reviewed lensman"
    },
    "client_name": {
      "type": "string",
      "description": "Name of the reviewer"
    },
    "rating": {
      "type": "number",
      "description": "Star rating 1-5"
    },
    "comment": {
      "type": "string",
      "description": "Written review"
    },
    "event_type": {
      "type": "string",
      "description": "Type of event for this review"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos from the event"
    }
  },
  "required": [
    "lensman_id",
    "rating"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.client_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}