{
  "description": "Every hour, pays out delivered bookings whose 48 hour window has closed with no problem reported.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "release_payouts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep_holds": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "releasePayouts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Release due payouts",
            "description": "Bookings past their 48 hour window"
          }
        }
      }
    ]
  },
  "name": "Release Payouts",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}